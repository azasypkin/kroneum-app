{
  "name": "kroneum",
  "version": "0.1.0",
  "private": true,
  "description": "A macOS menu-bar timer for regular eye breaks.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/azasypkin/kroneum-app.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "tauri build",
    "check": "tsc --noEmit && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run tests/unit",
    "test:ui": "playwright test",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "assets": "node scripts/generate-assets.mjs",
    "screenshots": "node scripts/capture-ui.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.58.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tauri-apps/cli": "^2.10.0",
    "@types/node": "^24.0.0",
    "prettier": "^3.8.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.0.0"
  }
}
